{
  "name": "tyonhaku-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/to-artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
